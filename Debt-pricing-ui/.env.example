# ---- Auth.js ----------------------------------------------------------------
# Random secret used to encrypt the session cookie:  openssl rand -base64 32
AUTH_SECRET=
# Public URL of this UI (required behind proxies; fine to keep for local dev)
AUTH_URL=http://localhost:3000

# ---- Keycloak (OIDC client "debt-pricing-ui") --------------------------------
AUTH_KEYCLOAK_ID=debt-pricing-ui
AUTH_KEYCLOAK_SECRET=
# Realm URL: http://localhost:8080/realms/<realm>   (Keycloak older than 17: .../auth/realms/<realm>)
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/debt-pricing

# ---- DebtPricing API ----------------------------------------------------------
DEBTPRICING_API_URL=http://localhost:5080
# Client ID of the API in Keycloak; client roles are read from resource_access[<this>].roles
DEBTPRICING_API_CLIENT_ID=debt-pricing-api
