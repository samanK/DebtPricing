{
  "realm": "debt-pricing",
  "enabled": true,
  "roles": {
    "client": {
      "debt-pricing-api": [
        { "name": "pricing-admin", "description": "Create, update and delete pricing models" },
        { "name": "pricing-user", "description": "Read pricing models and call the pricing services" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "debt-pricing-api",
      "name": "DebtPricing API (resource server)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "debt-pricing-ui",
      "name": "DebtPricing UI (Next.js)",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-ui-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "username": "alice", "enabled": true, "emailVerified": true,
      "email": "alice@example.com", "firstName": "Alice", "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice-pw", "temporary": false }],
      "clientRoles": { "debt-pricing-api": ["pricing-admin"] }
    },
    {
      "username": "bob", "enabled": true, "emailVerified": true,
      "email": "bob@example.com", "firstName": "Bob", "lastName": "User",
      "credentials": [{ "type": "password", "value": "bob-pw", "temporary": false }],
      "clientRoles": { "debt-pricing-api": ["pricing-user"] }
    }
  ]
}
